  m_Name: 
  m_EditorClassIdentifier: 
  nextLevelScene: Level 2
  finishPanel: {fileID: 1943929140}
  questName: Arahakan Karakter Ke Objek Yang Berwarna Merah!
  questText: {fileID: 2048048270}
  questPanel: {fileID: 976373266}
  questNamePanel: {fileID: 1273431037}
  questButton: {fileID: 1428907753}
  dialogData:
  - name: Traveler
    description: Wah, lihatlah! Dulu tempat bermain ini sangat bersih dan asri.
    dialogAudio: {fileID: 8300000, guid: 69bbc96505efe964f82f105d424a6535, type: 3}
  - name: Traveler
    description: Tetapi sekarang, ada banyak sampah yang berserakan di sini
    dialogAudio: {fileID: 8300000, guid: af26f89e4e69a554ebce4210f01e7d35, type: 3}
  - name: Traveler
    description: Saat hujan turun, tempat ini menjadi bau dan kotor.
    dialogAudio: {fileID: 8300000, guid: 478bb0e29c04e434988d6deccc167fea, type: 3}
  - name: Traveler
    description: Semua ini terjadi karena kita lupa menjaga kebersihan.
    dialogAudio: {fileID: 8300000, guid: 3e48a4954a5106b4caece82fac9f658e, type: 3}
  - name: Traveler
    description: Mari kita bantu membersihkan sampah-sampah ini bersama-sama ya!
    dialogAudio: {fileID: 8300000, guid: 4b6b903b73113d74eae30bb038e467fc, type: 3}
  - name: Traveler
    description: Meskipun melelahkan, ayo tetap semangat dan jangan menyerah.
    dialogAudio: {fileID: 8300000, guid: 97e54d28d94d02b479c09adca9ba54b5, type: 3}
  - name: Traveler
    description: Kamu pasti bisa membuat tempat ini indah dan bersih kembali!
    dialogAudio: {fileID: 8300000, guid: 60de40f46df20d341a299fef1ba51d46, type: 3}
  dialogPanel: {fileID: 2093868249}
  dialogName: {fileID: 1996780672}
